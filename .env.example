# Copia este archivo como .env para probar con `netlify dev`, o define las variables en Netlify.
ANTHROPIC_API_KEY=
# MANIGANTE_MODEL=claude-opus-5-5
# MANIGANTE_EFFORT=low

# Opcional · guardar cada reserva en Google Sheets (Apps Script con doPost, ver apps-script/Code.gs)
# RESERVATIONS_WEBHOOK_URL=

# Opcional · aviso automático al WhatsApp de Jorge (WhatsApp Cloud API de Meta)
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# OWNER_WHATSAPP=56958174288
# WHATSAPP_TEMPLATE=
# WHATSAPP_TEMPLATE_LANG=es

# Panel de Jorge (/admin.html) · mínimo 12 caracteres, larga y aleatoria
# ADMIN_TOKEN=

# Opcional · webhook de stock desde Apps Script (pushStock) → POST /api/stock
# STOCK_WEBHOOK_SECRET=

# Opcional · aviso por email de cada reserva (Resend)
# RESEND_API_KEY=
# OWNER_EMAIL=
# NOTIFY_FROM="MANI-GANTE <reservas@tudominio.cl>"

# Opcional · Instagram en vivo (publicaciones e historias de @mani_gant en la web)
# Token de larga duración de "Instagram API with Instagram Login" (Meta for Developers). Se renueva solo.
# INSTAGRAM_TOKEN=
