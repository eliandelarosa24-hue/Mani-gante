{
  "name": "red-vaeru",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Red Vaeru: estudio digital y asesoría para turismo y hospitalidad, con agente de IA cotizador.",
  "scripts": {
    "pages": "node scripts/build-pages.mjs && node scripts/build-samples.mjs && node scripts/build-works.mjs",
    "predev": "npm run pages",
    "dev": "vite",
    "prebuild": "npm run pages",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "images": "NODE_USE_ENV_PROXY=1 node scripts/gen-images.mjs",
    "collage": "node scripts/split-collage.mjs",
    "pack": "node scripts/pack-sample.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource-variable/host-grotesk": "^5.3.0",
    "@fontsource/fragment-mono": "^5.3.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "sharp": "^0.35.5",
    "vite": "^8.3.4"
  }
}
